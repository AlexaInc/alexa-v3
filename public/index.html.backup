<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alexa v3 | WhatsApp Bot Ecosystem</title>

    <link rel="icon"
        href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/wcAAwAB/rt2Br0AAAAASUVORK5CYII="
        type="image/png">
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar" id="navbar">
        <h1 onclick="location.href='./';">Alexa v3</h1>
        <div class="nav-buttons">
            <a href="#features" class="btn btn-outline" style="text-decoration: none;">Features</a>
            <a href="#deploy" class="btn btn-outline" style="text-decoration: none;">Deploy</a>
            <button id="loginButton" class="btn btn-outline" onclick="window.location.href='login.html'">Admin
                Login</button>
        </div>
    </nav>

    <main>
        <!-- Hero Section -->
        <section class="hero container">
            <h2 class="animate-fade">Social Intelligence.<br><span style="color: var(--accent-color)">Refined.</span>
            </h2>
            <p class="animate-fade" style="animation-delay: 0.2s">A specialized ecosystem of high-performance automation
                bots tailored for the next generation of social interaction.</p>

            <div class="status-box glass animate-fade"
                style="animation-delay: 0.4s; padding: 1.5rem; border-radius: 12px; display: inline-flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                <div id="statusDot"
                    style="width: 12px; height: 12px; border-radius: 50%; background-color: var(--danger); box-shadow: 0 0 10px var(--danger);">
                </div>
                <span style="font-weight: 600; font-size: 1.1rem;">Status: <span id="status"
                        style="color: var(--text-secondary)">Checking...</span></span>
            </div>

            <div class="animate-fade" style="animation-delay: 0.6s">
                <button class="btn btn-primary" onclick="sendMessage()"
                    style="padding: 1rem 3rem; font-size: 1.1rem;">Get Started on WhatsApp</button>
            </div>
        </section>

        <!-- Featured Section -->
        <section class="container" style="padding-bottom: 100px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                <div class="card glass">
                    <img src="https://pngimg.com/uploads/anime_girl/anime_girl_PNG33.png" alt="Alexa v3"
                        style="width: 100%; height: 250px; object-fit: contain; margin-bottom: 1.5rem;">
                    <h3 style="margin-bottom: 0.5rem; font-size: 1.5rem;">Industry Leading</h3>
                    <p style="color: var(--text-secondary);">Powerful utilities, advanced group management, and seamless
                        media processing built for the core community.</p>
                </div>
                <div class="card glass">
                    <div
                        style="height: 250px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            style="color: var(--accent-color)">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <h3 style="margin-bottom: 0.5rem; font-size: 1.5rem;">Secure & Fast</h3>
                    <p style="color: var(--text-secondary);">Built on the robust Baileys API with multi-layered
                        encryption and optimized performance for high-traffic environments.</p>
                </div>
            </div>
        </section>

        <!-- ================= FEATURES SHOWCASE ================= -->
        <section class="container" id="features" style="padding-bottom: 100px;">
            <div style="text-align: center; margin-bottom: 3rem;">
                <h2 style="font-size: 2.5rem; margin-bottom: 0.75rem;">Everything Alexa Can Do</h2>
                <p style="color: var(--text-secondary); max-width: 700px; margin: 0 auto;">
                    A full breakdown of every command category, straight from the bot's own <code>.menu</code>
                    system — nothing here is invented, it's a live mirror of what's inside the codebase.
                </p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">🛠 Utility</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        <code>.menu</code>/<code>.alive</code> interactive menu, <code>.ping</code> latency +
                        speedtest, <code>.weather</code>, <code>.news</code>, group/user IDs, view‑once reveal
                        (<code>.vv</code>), quote‑to‑sticker (<code>.q</code>), personal rank &amp; global/daily/weekly
                        leaderboards.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">👥 Group Management</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        Mute/unmute, warn system, add/remove/promote/demote members, invite links, anti‑link &amp;
                        anti‑NSFW auto‑moderation (delete/warn/remove), welcome/goodbye messages, word filters,
                        tag‑all, AI chatbot toggle per group, and bot‑account kicking.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">🖼 Stickers &amp; Media</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        Image/video → sticker conversion, emoji mixing, YouTube search &amp; download (audio/video),
                        web search, and an AI‑assisted web search mode.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">🖼 TextMaker</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        18 styled text-image generators — metallic, neon, matrix, glitch, fire, ice, thunder,
                        blackpink, hacker and more — turn any text into a styled image with one command.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">🪀 Games &amp; Fun</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        Slot machine, couple shipping, daily Q&amp;A, Word Chain, Hangman (with leaderboard),
                        turn‑based Battle Arena, social‑deduction Mafia, and Assassin — each with its own
                        registration → play → leaderboard flow.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">💰 AlexaCash Economy</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        A persistent MySQL‑backed currency (AC) with a Shop, an anime‑styled RPG progression system,
                        and an English‑only Truth or Dare game — all storing state in the database, not flat files.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">🌸 SFW / 🔞 NSFW Content</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        Curated safe‑for‑work image commands (coffee, food, anime), plus an 18+ command set that is
                        opt‑in and governable per‑group via the anti‑NSFW moderation controls.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">👑 Owner &amp; Admin Tools</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        Bot status/about/presence control, private‑chat &amp; group listings, maintenance mode,
                        top‑adder stats, task tracking, quiz‑pack management, and this very web Control Panel with
                        live CPU/RAM/network gauges and streaming logs.
                    </p>
                </div>

                <div class="card glass">
                    <h3 style="margin-bottom: 0.5rem;">☁️ Built‑in Cloudflare Tunnel</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        The app can expose its own web panel to the internet through a Cloudflare Tunnel it manages
                        itself — auto‑downloads the right <code>cloudflared</code> binary for your OS/CPU and shuts
                        the tunnel down automatically when the bot stops. No separate process to babysit.
                    </p>
                </div>

            </div>
        </section>

        <!-- ================= DEPLOYMENT GUIDE ================= -->
        <section class="container" id="deploy" style="padding-bottom: 100px;">
            <div style="text-align: center; margin-bottom: 3rem;">
                <h2 style="font-size: 2.5rem; margin-bottom: 0.75rem;">Deployment Guide</h2>
                <p style="color: var(--text-secondary); max-width: 700px; margin: 0 auto;">
                    A step-by-step walkthrough to get your own copy of Alexa v3 running — from a bare server or a
                    PaaS free tier, to a fully logged-in WhatsApp bot with a public admin panel.
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem; max-width: 850px; margin: 0 auto;">

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">1</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Prepare a MySQL database</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            Alexa stores group settings, conversation history, tasks, the economy, and the RPG/Shop
                            state in MySQL — not local JSON files. A free tier from
                            <a href="https://aiven.io" target="_blank" rel="noopener"
                                style="color: var(--accent-color);">aiven.io</a> works well. All tables are created
                            automatically with <code>CREATE TABLE IF NOT EXISTS</code> the first time the bot
                            connects — you only need the empty database and its credentials.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">2</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Clone the repository &amp; install dependencies</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            On a VPS/Linux box:
                        </p>
                        <pre class="code-block">apt update &amp;&amp; apt install -y speedtest-cli ffmpeg
git clone https://github.com/AlexaInc/alexa-v3.git
cd alexa-v3
npm install</pre>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.6rem;">
                            Or use the included <code>Dockerfile</code> (<code>docker build . -t alexa-v3 &amp;&amp;
                            docker run -p 8000:8000 alexa-v3</code>) — it already installs every native/system
                            dependency Puppeteer and image processing need.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">3</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Configure your environment</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            Copy <code>env_dummy</code> to <code>.env</code> and fill in the required values.
                            On a PaaS (Koyeb, Railway, Replit, Hugging Face Spaces), set the same keys as
                            environment/secret variables in the service dashboard instead of a file.
                        </p>
                        <pre class="code-block">cp env_dummy .env</pre>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.6rem;">
                            At minimum you need: <code>DB_HOST</code>, <code>DB_PORT</code>, <code>DB_NAME</code>,
                            <code>DB_UNAME</code>, <code>DB_PASS</code> (MySQL), <code>Owner_nb</code> /
                            <code>bot_nb</code> (WhatsApp numbers), and <code>ADMIN_USERNAME</code> /
                            <code>ADMIN_PASSWORD</code> / <code>SESSION_SECRET</code> for this control panel's
                            login. Everything else (AI keys, Tenor, proxy, Cloudflare Tunnel) is optional and only
                            unlocks extra features when filled in.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">4</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Start the bot</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            <code>app.js</code> is the process supervisor — it launches and auto‑restarts both the
                            WhatsApp connection (<code>src/index.js</code>) and this web panel
                            (<code>src/server.js</code>), and records why/when every restart happened.
                        </p>
                        <pre class="code-block">npm start</pre>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.6rem;">
                            Watch the terminal (or the <b>Control Panel → Logs</b> tab after step 5) for a QR code —
                            scan it from WhatsApp: <b>Linked Devices → Link a Device</b>.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">5</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Log in to the admin Control Panel</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            Open this site, click <b>Admin Login</b>, and sign in with the
                            <code>ADMIN_USERNAME</code> / <code>ADMIN_PASSWORD</code> you set in step 3. From
                            there you get live CPU/RAM/network graphs, streaming logs for both processes, and JSON
                            data downloads.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">6</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">(Optional) Expose it to the internet</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 0.6rem;">
                            If you're self‑hosting behind a home network or a sandbox with no public IP, set
                            <code>CLOUDFLARE_TUNNEL_TOKEN</code> (from a named tunnel in the Cloudflare Zero Trust
                            dashboard) or leave it blank to get a free temporary
                            <code>*.trycloudflare.com</code> link automatically — <code>app.js</code> downloads
                            <code>cloudflared</code> for your OS/CPU on first run and shuts the tunnel down the
                            moment the bot stops, so nothing is left running in the background.
                        </p>
                    </div>
                </div>

                <div class="card glass" style="display: flex; gap: 1.25rem; align-items: flex-start;">
                    <div class="step-num">7</div>
                    <div>
                        <h3 style="margin-bottom: 0.4rem;">Deploy to a free PaaS instead</h3>
                        <p style="color: var(--text-secondary); font-size: 0.95rem;">
                            Prefer not to run your own server? One‑click templates exist for
                            <a href="https://app.koyeb.com/deploy" target="_blank" rel="noopener"
                                style="color: var(--accent-color);">Koyeb</a>,
                            <a href="https://replit.com/github/hansaka02/alexa-v3" target="_blank" rel="noopener"
                                style="color: var(--accent-color);">Replit</a>, and
                            <a href="https://railway.app/new/template?repository=https://github.com/hansaka02/alexa-v3"
                                target="_blank" rel="noopener" style="color: var(--accent-color);">Railway</a> —
                            just supply the same environment variables from step 3 in their dashboard.
                        </p>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <footer class="container"
        style="padding: 4rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
        <p style="color: var(--text-secondary);">&copy; 2026 Hansaka Rasanjana (AlexaInc). Built for the Decentralized
            Social World.</p>
        <p style="font-size: 0.85rem; color: #475569; margin-top: 0.5rem;">Developer: Hansaka</p>
    </footer>

    <script>
        // Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        async function checkStatus() {
            try {
                const response = await fetch('/status');
                const data = await response.json();
                const statusEl = document.getElementById('status');
                const dot = document.getElementById('statusDot');

                statusEl.textContent = data.status;
                if (data.status === "Online") {
                    statusEl.style.color = "var(--success)";
                    dot.style.backgroundColor = "var(--success)";
                    dot.style.boxShadow = "0 0 10px var(--success)";
                } else {
                    statusEl.style.color = "var(--danger)";
                    dot.style.backgroundColor = "var(--danger)";
                    dot.style.boxShadow = "0 0 10px var(--danger)";
                }
            } catch (error) {
                document.getElementById('status').textContent = "Offline";
            }
        }

        checkStatus();
        setInterval(checkStatus, 5000);

        async function getPhoneNumber() {
            try {
                const response = await fetch('/get-phone-number');
                const data = await response.json();
                return data.phoneNumber;
            } catch (error) {
                return null;
            }
        }

        async function sendMessage() {
            const phoneNumber = await getPhoneNumber();
            if (phoneNumber) {
                const message = 'Hello, I want to talk to Alexa!';
                const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
                window.open(whatsappUrl, '_blank');
            } else {
                alert('Unable to retrieve bot phone number.');
            }
        }

        async function checkLoginStatus() {
            try {
                const response = await fetch('/is-logged-in');
                const data = await response.json();
                const loginButton = document.getElementById('loginButton');
                if (data.isLoggedIn) {
                    loginButton.textContent = 'Control Panel';
                    loginButton.onclick = function () { window.location.href = '/control'; };
                } else {
                    loginButton.textContent = 'Admin Login';
                    loginButton.onclick = function () { window.location.href = 'login.html'; };
                }
            } catch (error) {
                console.error("Error checking login status:", error);
            }
        }

        checkLoginStatus();
    </script>
</body>

</html>