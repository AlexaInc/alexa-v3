<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Control Panel | Alexa v3</title>
  <link rel="stylesheet" href="style.css">
  <style>
    .dashboard-grid {
      margin-top: 100px;
      padding-bottom: 50px;
    }

    .stats-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2rem;
    }

    .gauge-card {
      text-align: center;
      padding: 1.5rem;
      position: relative;
    }

    .gauge-svg {
      width: 140px;
      height: 140px;
      transform: rotate(-90deg);
    }

    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.05);
      stroke-width: 10;
    }

    .gauge-progress {
      fill: none;
      stroke: var(--accent-color);
      stroke-width: 10;
      stroke-linecap: round;
      stroke-dasharray: 408;
      /* 2 * PI * r (r=65) */
      stroke-dashoffset: 408;
      transition: stroke-dashoffset 0.5s ease;
    }

    .gauge-value {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 1.25rem;
      font-weight: 700;
    }

    .gauge-label {
      margin-top: 1rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    #download-section {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }
  </style>
</head>

<body>

  <nav class="navbar scrolled">
    <h1 onclick="location.href='./';">Alexa v3</h1>
    <div class="nav-buttons">
      <button class="btn btn-outline" onclick="logout()">Logout</button>
    </div>
  </nav>

  <main class="container dashboard-grid">
    <div class="stats-header">
      <div>
        <h2 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Command Center</h2>
        <p style="color: var(--text-secondary);">Real-time system diagnostics and process logs.</p>
      </div>
      <div id="download-section">
        <button class="btn btn-outline" id="downloadButton" style="font-size: 0.8rem;">📦 Users.json</button>
        <button class="btn btn-outline" id="downloadButton2" style="font-size: 0.8rem;">🎮 Hangman.json</button>
      </div>
    </div>

    <div class="gauges-grid">
      <div class="gauge-card glass card">
        <div style="position: relative; display: inline-block;">
          <svg class="gauge-svg" viewBox="0 0 140 140">
            <circle class="gauge-bg" cx="70" cy="70" r="65"></circle>
            <circle id="cpuGauge" class="gauge-progress" cx="70" cy="70" r="65"></circle>
          </svg>
          <div class="gauge-value" id="cpuValue">0%</div>
        </div>
        <div class="gauge-label">CPU Load</div>
      </div>

      <div class="gauge-card glass card">
        <div style="position: relative; display: inline-block;">
          <svg class="gauge-svg" viewBox="0 0 140 140">
            <circle class="gauge-bg" cx="70" cy="70" r="65"></circle>
            <circle id="memGauge" class="gauge-progress" cx="70" cy="70" r="65"></circle>
          </svg>
          <div class="gauge-value" id="memValue">0%</div>
        </div>
        <div class="gauge-label">Memory</div>
      </div>

      <div class="gauge-card glass card">
        <div style="position: relative; display: inline-block;">
          <svg class="gauge-svg" viewBox="0 0 140 140">
            <circle class="gauge-bg" cx="70" cy="70" r="65"></circle>
            <circle id="dlGauge" class="gauge-progress" cx="70" cy="70" r="65"></circle>
          </svg>
          <div class="gauge-value" id="dlValue" style="font-size: 1rem;">0 Mbps</div>
        </div>
        <div class="gauge-label">Download</div>
      </div>

      <div class="gauge-card glass card">
        <div style="position: relative; display: inline-block;">
          <svg class="gauge-svg" viewBox="0 0 140 140">
            <circle class="gauge-bg" cx="70" cy="70" r="65"></circle>
            <circle id="ulGauge" class="gauge-progress" cx="70" cy="70" r="65"></circle>
          </svg>
          <div class="gauge-value" id="ulValue" style="font-size: 1rem;">0 Mbps</div>
        </div>
        <div class="gauge-label">Upload</div>
      </div>
    </div>

    <div class="log-container glass">
      <div class="log-header">
        <div class="log-tabs">
          <button id="indexLogTab" class="active" onclick="switchLogTab('index')">index.js</button>
          <button id="serverLogTab" onclick="switchLogTab('server')">server.js</button>
        </div>
        <div style="margin-left: auto; color: var(--text-secondary); font-size: 0.8rem; font-family: monospace;">
          Live Streaming...
        </div>
      </div>
      <div id="indexLogArea" class="log-area"></div>
      <div id="serverLogArea" class="log-area" style="display: none;"></div>
    </div>

    <!-- ================= ADMIN REFERENCE: FEATURES + DEPLOYMENT ================= -->
    <div style="margin-top: 3rem;">

      <div class="accordion glass card" id="featuresAccordion">
        <button class="accordion-toggle" onclick="toggleAccordion('featuresAccordion')">
          <span>📖 Bot Features Reference</span>
          <span class="accordion-chevron">▾</span>
        </button>
        <div class="accordion-body">
          <div class="ref-grid">
            <div class="ref-item">
              <h4>🛠 Utility</h4>
              <p><code>.menu</code>/<code>.alive</code>, <code>.ping</code> (+ speedtest), <code>.weather</code>,
                <code>.news</code>, IDs, <code>.vv</code> view-once reveal, <code>.q</code> quote-to-sticker,
                rank &amp; leaderboards.</p>
            </div>
            <div class="ref-item">
              <h4>👥 Group Management</h4>
              <p>Mute/warn, add/remove/promote/demote, invites, anti-link &amp; anti-NSFW auto-mod, welcome/goodbye,
                filters, tag-all, per-group AI chatbot toggle.</p>
            </div>
            <div class="ref-item">
              <h4>🖼 Stickers &amp; Media</h4>
              <p>Image/video → sticker, emoji mixing, YouTube search/download, web search, AI-assisted search.</p>
            </div>
            <div class="ref-item">
              <h4>🖼 TextMaker</h4>
              <p>18 styled text-image generators (metallic, neon, matrix, glitch, fire, blackpink, and more).</p>
            </div>
            <div class="ref-item">
              <h4>🪀 Games &amp; Fun</h4>
              <p>Slot, couple shipping, daily Q&amp;A, Word Chain, Hangman, Battle Arena, Mafia, Assassin — each with
                its own leaderboard.</p>
            </div>
            <div class="ref-item">
              <h4>💰 AlexaCash Economy</h4>
              <p>MySQL-backed AC currency, Shop, anime-styled RPG, and English-only Truth or Dare.</p>
            </div>
            <div class="ref-item">
              <h4>🌸 SFW / 🔞 NSFW</h4>
              <p>Curated safe image commands plus an opt-in 18+ set, governable per-group via anti-NSFW controls.</p>
            </div>
            <div class="ref-item">
              <h4>👑 Owner &amp; Admin</h4>
              <p>Status/about/presence, chat &amp; group listings, maintenance mode, task tracking, quiz-pack
                management, and this Control Panel.</p>
            </div>
            <div class="ref-item">
              <h4>☁️ Cloudflare Tunnel</h4>
              <p>Self-managed tunnel — auto-downloads <code>cloudflared</code> for your OS/CPU, dies with the app,
                zero orphan processes.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="accordion glass card" id="deployAccordion" style="margin-top: 1.5rem;">
        <button class="accordion-toggle" onclick="toggleAccordion('deployAccordion')">
          <span>🚀 Deployment Guide</span>
          <span class="accordion-chevron">▾</span>
        </button>
        <div class="accordion-body">
          <ol class="deploy-steps">
            <li>
              <b>Prepare a MySQL database</b> — group settings, conversation history, tasks, the economy and
              RPG/Shop state all live in MySQL. Tables are created automatically
              (<code>CREATE TABLE IF NOT EXISTS</code>) on first connect; you only need empty database credentials.
            </li>
            <li>
              <b>Clone &amp; install</b>
              <pre class="code-block">git clone https://github.com/AlexaInc/alexa-v3.git
cd alexa-v3
npm install</pre>
              or build the included <code>Dockerfile</code>, which already has every native/system dependency.
            </li>
            <li>
              <b>Configure environment</b> — copy <code>env_dummy</code> to <code>.env</code> (or set the same keys
              as PaaS secrets). Minimum required: <code>DB_HOST</code>, <code>DB_PORT</code>, <code>DB_NAME</code>,
              <code>DB_UNAME</code>, <code>DB_PASS</code>, <code>Owner_nb</code>, <code>bot_nb</code>,
              <code>ADMIN_USERNAME</code>, <code>ADMIN_PASSWORD</code>, <code>SESSION_SECRET</code>.
            </li>
            <li>
              <b>Start the bot</b> — <code>npm start</code> runs <code>app.js</code>, the process supervisor that
              launches and auto-restarts both the WhatsApp connection and this web panel, logging every restart's
              id/timestamp/reason (shown in the WhatsApp startup message and available in <code>data/restarts.json</code>).
              Scan the QR code from WhatsApp → Linked Devices.
            </li>
            <li>
              <b>Log in here</b> — use the <code>ADMIN_USERNAME</code>/<code>ADMIN_PASSWORD</code> from step 3 to
              reach this Control Panel: live CPU/RAM/network gauges, streaming logs for both processes, and JSON
              data downloads.
            </li>
            <li>
              <b>(Optional) Expose it publicly</b> — set <code>CLOUDFLARE_TUNNEL_TOKEN</code> for a named tunnel,
              or leave it blank for a free temporary <code>*.trycloudflare.com</code> link. The tunnel is
              auto-downloaded per OS/CPU and shuts down automatically when the bot stops.
            </li>
            <li>
              <b>Or deploy to a free PaaS</b> — one-click templates exist for
              <a href="https://app.koyeb.com/deploy" target="_blank" rel="noopener">Koyeb</a>,
              <a href="https://replit.com/github/hansaka02/alexa-v3" target="_blank" rel="noopener">Replit</a>, and
              <a href="https://railway.app/new/template?repository=https://github.com/hansaka02/alexa-v3" target="_blank" rel="noopener">Railway</a> —
              just supply the same environment variables.
            </li>
          </ol>
        </div>
      </div>

    </div>
  </main>

  <script>
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const socketUrl = `${protocol}//${window.location.host}/logs`;
    const socket = new WebSocket(socketUrl);

    // How close (in px) to the bottom counts as "still following the live tail".
    // If the user has scrolled up past this threshold to read older logs,
    // we leave their scroll position alone instead of yanking them back down
    // on every update (the server pushes new logs every ~100ms).
    const AUTO_SCROLL_THRESHOLD_PX = 40;

    function isNearBottom(el) {
      return el.scrollHeight - el.scrollTop - el.clientHeight <= AUTO_SCROLL_THRESHOLD_PX;
    }

    socket.onmessage = function (event) {
      const data = JSON.parse(event.data);
      const logType = data.type;
      const logArea = logType === 'index' ? document.getElementById('indexLogArea') : document.getElementById('serverLogArea');

      // Decide BEFORE mutating the DOM whether the user was already following
      // the live tail (at/near the bottom) or had scrolled up to read back.
      const shouldAutoScroll = isNearBottom(logArea);

      logArea.innerHTML = "";

      data.logs.forEach(log => {
        const logEntry = document.createElement('div');
        logEntry.className = `log-line ${logType}`;
        logEntry.innerText = log;
        logArea.appendChild(logEntry);
      });

      // Only snap to the bottom if the user hadn't scrolled up on purpose —
      // this is the fix for logs auto-scrolling out from under you while
      // reading older lines.
      if (shouldAutoScroll) {
        logArea.scrollTop = logArea.scrollHeight;
      }
    };

    function toggleAccordion(id) {
      document.getElementById(id).classList.toggle('open');
    }

    function switchLogTab(logType) {
      const indexTab = document.getElementById('indexLogTab');
      const serverTab = document.getElementById('serverLogTab');
      const indexLogArea = document.getElementById('indexLogArea');
      const serverLogArea = document.getElementById('serverLogArea');

      if (logType === 'index') {
        indexTab.classList.add('active');
        serverTab.classList.remove('active');
        indexLogArea.style.display = 'block';
        serverLogArea.style.display = 'none';
      } else {
        serverTab.classList.add('active');
        indexTab.classList.remove('active');
        serverLogArea.style.display = 'block';
        indexLogArea.style.display = 'none';
      }
    }

    // Auth Check
    fetch('/is-logged-in')
      .then(response => response.json())
      .then(data => {
        if (!data.isLoggedIn) window.location.href = '/login';
      })
      .catch(() => window.location.href = '/login');

    function logout() {
      fetch('/logout', { method: 'POST' })
        .then(response => response.json())
        .then(data => {
          if (data.success) window.location.href = '/login';
        });
    }

    // Gauge Control
    const circ = 2 * Math.PI * 65;

    function setCircleProgress(id, percent) {
      const circle = document.getElementById(id);
      const offset = circ - (percent / 100 * circ);
      circle.style.strokeDashoffset = offset;
    }

    async function fetchsysStats() {
      try {
        const response = await fetch('/sysstats');
        const data = await response.json();

        // CPU
        const cpuVal = data.cpu.toFixed(0);
        document.getElementById('cpuValue').textContent = cpuVal + '%';
        setCircleProgress('cpuGauge', cpuVal);

        // Memory
        const memVal = data.memory.toFixed(0);
        document.getElementById('memValue').textContent = memVal + '%';
        setCircleProgress('memGauge', memVal);

        // Download
        let dlMbps = (data.downloadSpeed * 8) / 1_000_000;
        dlMbps = parseFloat(dlMbps.toFixed(2));
        document.getElementById('dlValue').textContent = dlMbps + ' Mbps';
        setCircleProgress('dlGauge', Math.min((dlMbps / 100) * 100, 100));

        // Upload
        let ulMbps = (data.uploadSpeed * 8) / 1_000_000;
        ulMbps = parseFloat(ulMbps.toFixed(2));
        document.getElementById('ulValue').textContent = ulMbps + ' Mbps';
        setCircleProgress('ulGauge', Math.min((ulMbps / 100) * 100, 100));

      } catch (error) {
        console.error("Error fetching stats:", error);
      }
    }

    setInterval(fetchsysStats, 1000);
    fetchsysStats();

    // Download handlers
    document.getElementById('downloadButton').addEventListener('click', () => downloadFile('/download-users-json', 'users.json'));
    document.getElementById('downloadButton2').addEventListener('click', () => downloadFile('/download-hangman-json', 'hangman.json'));

    function downloadFile(url, filename) {
      fetch(url).then(res => res.blob()).then(blob => {
        const a = document.createElement('a');
        a.href = window.URL.createObjectURL(blob);
        a.download = filename;
        a.click();
      });
    }
  </script>
</body>

</html>